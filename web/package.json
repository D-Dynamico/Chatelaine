{
  "name": "chatelaine-web",
  "version": "1.0.0",
  "private": true,
  "description": "Chatelaine web app: an Angular SPA that shows each role only what the API lets it see",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "lint": "eslint . --max-warnings 0 && node scripts/check-lockfile.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "ng build --configuration development && tsc --noEmit -p tsconfig.spec.json",
    "test": "ng test --watch=false"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.2",
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/forms": "~22.2.1",
    "@angular/material": "~22.2.2",
    "@angular/platform-browser": "~22.2.1",
    "@angular/router": "~22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
