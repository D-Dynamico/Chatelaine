# Copy to .env and adjust. Never commit .env. Parsed and validated by src/config.ts at boot.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Storage adapter: file | mongo | dynamo (docs/ARCHITECTURE.md §6)
STORAGE=file

# file adapter
DATA_FILE=data/chatelaine.xml

# mongo adapter (local: docker compose up -d mongo; production: MongoDB Atlas M0)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=chatelaine

# dynamo adapter (local only: docker compose up -d dynamodb)
DYNAMO_ENDPOINT=http://localhost:8000
DYNAMO_REGION=local
DYNAMO_TABLE=chatelaine
# DynamoDB Local accepts any credentials; these are placeholders, not secrets
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Auth: use a long random string outside local development
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=2h

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:4200

# Express "trust proxy" hop count. Leave empty locally; 3 on Render (docs/API.md §8)
TRUST_PROXY=

# Enables the delay and fail query parameters (docs/API.md §9)
SIMULATION_ENABLED=true
